{
  "name": "@bullet/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Bullet deposit indexer — Poseidon Merkle tree + root poster + witness API",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@bullet/sdk": "link:../sdk",
    "dotenv": "^16.0.0",
    "fastify": "^5.2.1",
    "mongodb": "^6.16.0",
    "viem": "^2.26.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "5.8.3"
  }
}
