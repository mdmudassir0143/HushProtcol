# Hush Indexer · Arc Testnet
# Addresses from ../deployments/arcTestnet.json (2026-07-22)

RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002

BULLET_POOL_ADDRESS=0x9E65584C6ACE76cEFde4FD5f50E6bB9763999dCe
MERKLE_ROOT_MANAGER_ADDRESS=0x6D6530A1fC908792DA2aa533a5F299283E6F062a

# Dedicated root-poster key — must own MerkleRootManager. NEVER a user key.
RELAYER_PRIVATE_KEY=

# MongoDB Atlas (deposits / roots / sync cursor). Never commit real credentials.
# DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/hushh_indexer?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/hushh_indexer?retryWrites=true&w=majority

# Event ingest: goldsky (default) or rpc
EVENT_SOURCE=goldsky
GOLDSKY_BULLET_POOL_URL=https://api.goldsky.com/api/public/project_cmrzb84g5syuc01vz6wx2ad6n/subgraphs/BulletPool/1.0.0/gn
GOLDSKY_ROOT_MANAGER_URL=https://api.goldsky.com/api/public/project_cmrzb84g5syuc01vz6wx2ad6n/subgraphs/MerkleRootManager/1.0.0/gn

# Sync
CONFIRMATIONS=8
POLL_INTERVAL_MS=4000
# Near deploy / first deposits (Arc tip is ~53M). Avoid 0 — catch-up takes forever.
START_BLOCK=53078000
TREE_DEPTH=20
API_PORT=4010
# Local frontend:
CORS_ORIGIN=http://localhost:3000
# Hosted: CORS_ORIGIN=https://hush-protocol-zeta.vercel.app

# Optional: skip posting roots (dev / dry-run)
SKIP_POST_ROOT=0
