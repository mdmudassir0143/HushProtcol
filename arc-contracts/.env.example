# Deployer key (required for remote networks)
PRIVATE_KEY=

# ── Arc Testnet (primary) ────────────────────────────────────────────────────
# Network: Arc Testnet · Chain ID: 5042002 · Currency: USDC
# Explorer: https://testnet.arcscan.app
# Official RPC (preferred). Fallback: https://5042002.rpc.thirdweb.com
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARCSCAN_API_KEY=

# Somnia (optional)
SOMNIA_TESTNET_RPC_URL=https://dream-rpc.somnia.network/
SOMNIA_MAINNET_RPC_URL=https://api.infra.mainnet.somnia.network/

# Who owns MerkleRootManager / can postRoot (defaults to deployer)
RELAYER_ADDRESS=

# Token / mint knobs used by deploy scripts
MINT_TO=
MINT_AMOUNT=1000000
SKIP_TOKEN=
SKIP_MINT=
ADD_TO_POOL=1

# Per-script overrides (defaults match deployments/arcTestnet.json)
POOL_ADDRESS=0x9E65584C6ACE76cEFde4FD5f50E6bB9763999dCe
TOKEN_ADDRESS=0x7d7aF5715e5671e0E3126b2428Dc2629bD9061e3
TOKEN_DECIMALS=
TOKEN_SYMBOL=
ROOT=
ROOT_MANAGER_ADDRESS=0x6D6530A1fC908792DA2aa533a5F299283E6F062a
ACTION=

# ── Indexer (see indexer/.env.example) ───────────────────────────────────────
# BULLET_POOL_ADDRESS=0x9E65584C6ACE76cEFde4FD5f50E6bB9763999dCe
# MERKLE_ROOT_MANAGER_ADDRESS=0x6D6530A1fC908792DA2aa533a5F299283E6F062a
# RELAYER_PRIVATE_KEY=
# DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/hushh_indexer?retryWrites=true&w=majority
# CONFIRMATIONS=8
# API_PORT=4010
