# MongoDB Atlas (users + encrypted notes). Never commit real credentials.
# Prefer MONGODB_URI so Render's auto-injected Postgres DATABASE_URL cannot break Prisma.
MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/hushh?retryWrites=true&w=majority"

JWT_SECRET="change-me-bullet-hackathon-secret"
JWT_TTL_HOURS=72
PORT=4020
HOST=0.0.0.0
# Local frontend. Hosted: https://hushh-inky.vercel.app
CORS_ORIGIN=http://localhost:3000

# Privy (verify Twitter OAuth on link). Keep secret server-side only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
